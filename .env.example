# SILELO / SlieQwenBoss Lo8 provider configuration
# Never commit real API keys.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Existing Manus/Forge integration (optional when external providers are enabled)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Database / auth
DATABASE_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
JWT_SECRET=

# OpenRouter — OpenAI-compatible unified gateway
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODELS=openrouter/free,openai/gpt-oss-120b:free,qwen/qwen3-coder:free,deepseek/deepseek-r1:free,google/gemma-3-27b-it:free,meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODELS=${OPENROUTER_FREE_MODELS}

# Groq — OpenAI-compatible fast provider
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FREE_MODELS=llama-3.1-8b-instant,gemma2-9b-it

# Qwen / DashScope — OpenAI-compatible endpoint
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_FREE_MODELS=qwen-turbo,qwen-plus

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.0-flash-exp

# MCP bridge
MCP_ENABLED=false
MCP_WRITE_ENABLED=false
MCP_SERVER_URL=http://localhost:3001/mcp
