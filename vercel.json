{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://silelo.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://silelo.onrender.com/health"
    },
    {
      "source": "/chat/:path*",
      "destination": "/"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
